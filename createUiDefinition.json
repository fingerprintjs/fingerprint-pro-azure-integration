{
  "$schema": "https://schema.management.azure.com/schemas/0.1.2-preview/CreateUIDefinition.MultiVm.json#",
  "handler": "Microsoft.Azure.CreateUIDef",
  "version": "0.1.2-preview",
  "parameters": {
    "basics": [
      {
        "name": "functionAppName",
        "type": "Microsoft.Common.TextBox",
        "label": "Function App Name",
        "defaultValue": "azure-frontdoor-proxy-app"
      },
      {
        "name": "location",
        "type": "Microsoft.Common.DropDown",
        "label": "Location",
        "defaultValue": "EastUS",
        "constraints": {
          "allowedValues": [
            { "label": "EastUS", "value": "EastUS" },
            { "label": "EastUS2", "value": "EastUS2" },
            { "label": "WestUS", "value": "WestUS" },
            { "label": "WestEurope", "value": "WestEurope" },
            { "label": "EastAsia", "value": "EastAsia" },
            { "label": "SouthEastAsia", "value": "SouthEastAsia" },
            { "label": "JapanEast", "value": "JapanEast" },
            { "label": "JapanWest", "value": "JapanWest" },
            { "label": "NorthCentralUS", "value": "NorthCentralUS" },
            { "label": "SouthCentralUS", "value": "SouthCentralUS" },
            { "label": "CentralUS", "value": "CentralUS" },
            { "label": "NorthEurope", "value": "NorthEurope" },
            { "label": "BrazilSouth", "value": "BrazilSouth" },
            { "label": "AustraliaEast", "value": "AustraliaEast" },
            { "label": "AustraliaSouthEast", "value": "AustraliaSouthEast" },
            { "label": "SouthIndia", "value": "SouthIndia" },
            { "label": "CentralIndia", "value": "CentralIndia" },
            { "label": "WestIndia", "value": "WestIndia" },
            { "label": "CanadaEast", "value": "CanadaEast" },
            { "label": "CanadaCentral", "value": "CanadaCentral" },
            { "label": "WestUS2", "value": "WestUS2" },
            { "label": "WestCentralUS", "value": "WestCentralUS" },
            { "label": "UKSouth", "value": "UKSouth" },
            { "label": "UKWest", "value": "UKWest" },
            { "label": "KoreaCentral", "value": "KoreaCentral" },
            { "label": "KoreaSouth", "value": "KoreaSouth" },
            { "label": "FranceCentral", "value": "FranceCentral" },
            { "label": "AustraliaCentral", "value": "AustraliaCentral" },
            { "label": "SouthAfricaNorth", "value": "SouthAfricaNorth" },
            { "label": "UAENorth", "value": "UAENorth" },
            { "label": "SwitzerlandNorth", "value": "SwitzerlandNorth" },
            { "label": "GermanyWestCentral", "value": "GermanyWestCentral" },
            { "label": "NorwayEast", "value": "NorwayEast" },
            { "label": "WestUS3", "value": "WestUS3" },
            { "label": "JioIndiaWest", "value": "JioIndiaWest" },
            { "label": "SwedenCentral", "value": "SwedenCentral" },
            { "label": "QatarCentral", "value": "QatarCentral" }
          ]
        }
      }
    ],
    "steps": [
      {
        "name": "routingConfig",
        "label": "Routing Configuration",
        "subLabel": {
          "preValidation": "Configure route paths",
          "postValidation": "Done"
        },
        "bladeTitle": "Routing",
        "elements": [
          {
            "name": "routePrefix",
            "type": "Microsoft.Common.TextBox",
            "label": "Route Prefix (your `FPJS_ROUTE_PREFIX` variable value)",
            "defaultValue": "fpjs"
          },
          {
            "name": "legacyOptions",
            "type": "Microsoft.Common.Section",
            "label": "Legacy JS Agent V3 Options",
            "elements": [
              {
                "name": "agentDownloadPath",
                "type": "Microsoft.Common.TextBox",
                "label": "Agent Download Path",
                "defaultValue": "agent"
              },
              {
                "name": "getResultPath",
                "type": "Microsoft.Common.TextBox",
                "label": "Get Result Path",
                "defaultValue": "result"
              }
            ],
            "visible": true
          }
        ]
      },
      {
        "name": "scaling",
        "label": "Scaling",
        "elements": [
          {
            "name": "maximumInstanceCount",
            "type": "Microsoft.Common.TextBox",
            "label": "Maximum Instance Count",
            "defaultValue": "100",
            "constraints": {
              "required": true,
              "regex": "^[1-9][0-9]*$",
              "validationMessage": "Must be a positive integer."
            }
          }
        ]
      },
      {
        "name": "security",
        "label": "Security",
        "elements": [
          {
            "name": "preSharedSecret",
            "type": "Microsoft.Common.PasswordBox",
            "constraints": {
              "required": true
            },
            "label": {
              "password": "Proxy Secret",
              "confirmPassword": "Confirm Secret"
            }
          }
        ]
      }
    ],
    "outputs": {
      "location": "[basics('location')]",
      "functionAppName": "[basics('functionAppName')]",
      "routePrefix": "[steps('routingConfig').routePrefix]",
      "agentDownloadPath": "[steps('routingConfig').legacyOptions.agentDownloadPath]",
      "getResultPath": "[steps('routingConfig').legacyOptions.getResultPath]",
      "preSharedSecret": "[steps('security').preSharedSecret]",
      "maximumInstanceCount": "[int(steps('scaling').maximumInstanceCount)]"
    }
  }
}
