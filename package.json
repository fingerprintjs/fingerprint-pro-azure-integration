{
  "name": "@fingerprint/azure-frontdoor-proxy",
  "version": "2.1.0",
  "description": "Fingerprint Azure Front Door Proxy integration",
  "license": "MIT",
  "sideEffects": false,
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "build": "rimraf dist && NODE_OPTIONS=\"--max_old_space_size=4098\" vite build",
    "build:release": "FPDCN=fpcdn.io INGRESS_API=api.fpjs.io IS_RELEASE_BUILD=true pnpm build",
    "prepare-package": "./scripts/preparePackage.sh",
    "watch": "vite build --watch",
    "prepare": "husky install",
    "lint": "eslint --max-warnings 0",
    "lint:fix": "pnpm lint --fix",
    "test": "vitest run",
    "test:dts": "tsc --project tsconfig.eslint.json",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:coverage:diff": "vitest run --coverage --reporter json --outputFile.json=report.json",
    "test:e2e": "npx playwright test --config e2e/playwright.config.ts",
    "test:mock-e2e": "node e2e/scripts/mockTests.ts",
    "emulate-storage": "azurite -l ./storage -L",
    "start": "cd dist && func start",
    "start:example-website": "cd example-website && vite",
    "build:example-website": "cd example-website && vite build",
    "cleanup-dangling-resource-groups": "node --experimental-transform-types scripts/cleanupDanglingResourceGroups.ts",
    "e2e-deploy-infra": "node --experimental-transform-types e2e/infra/scripts/deploy.ts",
    "e2e-destroy-infra": "node --experimental-transform-types e2e/infra/scripts/destroy.ts",
    "changeset:publish": "HUSKY=0 changeset publish && pnpm build:release && pnpm prepare-package",
    "changeset:version": "changeset version"
  },
  "dependencies": {
    "@azure/arm-appservice": "19.0.0",
    "@azure/arm-storage": "20.1.0",
    "@azure/functions": "4.16.2",
    "@azure/identity": "4.13.1",
    "@azure/storage-blob": "12.33.0",
    "cockatiel": "4.0.0",
    "semver": "7.8.5",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@azure/arm-cdn": "9.1.0",
    "@azure/arm-frontdoor": "^5.3.0",
    "@azure/arm-resources": "8.0.0",
    "@azure/arm-resourcesdeployments": "1.0.0",
    "@changesets/cli": "2.31.1",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@fingerprint/agent": "^4.1.3",
    "@fingerprintjs/changesets-changelog-format": "^0.2.0",
    "@fingerprintjs/commit-lint-dx-team": "^0.1.0",
    "@fingerprintjs/conventional-changelog-dx-team": "^0.2.0",
    "@fingerprintjs/eslint-config-dx-team": "^3.0.0",
    "@fingerprintjs/fingerprintjs-pro": "^3.12.13",
    "@fingerprintjs/prettier-config-dx-team": "^0.3.0",
    "@fingerprintjs/tsconfig-dx-team": "^0.0.2",
    "@playwright/test": "1.61.1",
    "@types/node": "26.1.1",
    "@types/semver": "^7.7.1",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "@vitest/coverage-istanbul": "^4.1.10",
    "azure-functions-core-tools": "^4.12.1",
    "azurite": "^3.36.0",
    "commitizen": "^4.3.2",
    "conventional-changelog-conventionalcommits": "10.2.1",
    "cz-conventional-changelog": "^3.3.0",
    "dotenv": "^17.4.2",
    "eslint": "^10.7.0",
    "fetch-mock": "^12.6.0",
    "glob": "13.0.6",
    "husky": "^9.1.7",
    "lint-staged": "^17.1.0",
    "playwright": "1.61.1",
    "prettier": "^3.9.6",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vite": "8.1.5",
    "vitest": "^4.1.10"
  },
  "lint-staged": {
    "*.ts": "pnpm lint:fix",
    "*.tsx": "pnpm lint:fix"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "packageManager": "pnpm@11.15.1+sha512.81350b07e53c9538a02f1f2303b4290fa2d7be04e56e2a970c4cc4b417dc761de196edabd49d55c7dc9580db81007c44143e4e3d7e462b3000d23c255122d065"
}
